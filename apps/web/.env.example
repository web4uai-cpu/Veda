# VEDA Web — Environment Variables
# Copy to .env.local for local development.

# FastAPI backend base URL (required in production deployments)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site origin — used for canonical URLs, OpenGraph, sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: internal API URL for server-side rendering (falls back to NEXT_PUBLIC_API_URL)
# API_URL=http://api.internal:8000
