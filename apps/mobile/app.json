{
  "expo": {
    "name": "VEDA",
    "slug": "veda-the-sanatan-wisdom",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "veda",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F1A",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.veda.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.veda.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0F1A",
          "dark": { "backgroundColor": "#0B0F1A" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a7b8e319-f518-4cf0-a919-5a5ff24eec70"
      }
    },
    "owner": "web4uai-2"
  }
}
