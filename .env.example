# =============================================================================
# VEDA Environment Variables
# =============================================================================
# Copy this to .env.local and fill in your values
# =============================================================================

# --- PostgreSQL (Railway in production, local Docker in development) ---
DATABASE_URL=postgresql://veda:vedadev2026@localhost:5432/veda

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vedadev2026

# --- Qdrant (Vector Database) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- OpenSearch (Full-Text Search) ---
OPENSEARCH_URL=http://localhost:9200

# --- Redis (Cache) ---
REDIS_URL=redis://localhost:6379

# --- LLM (via OpenRouter) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PRIMARY_MODEL=openai/gpt-5.5
LLM_FALLBACK_MODEL=anthropic/claude-sonnet-4

# --- Embeddings ---
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NODE_ENV=development

# --- Auth (deferred) ---
# Add Clerk, Auth.js, Better Auth, or Supabase variables later when auth is enabled.
