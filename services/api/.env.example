# =============================================================================
# VEDA API — Environment Variables
# =============================================================================
# Copy this to .env and fill in your values.
# Railway: set these in the Variables tab for the @veda/api service.

# --- PostgreSQL (Required) ---
DATABASE_URL=postgresql://veda:vedadev2026@localhost:5432/veda

# --- Neo4j (Optional — graph features degrade gracefully) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vedadev2026

# --- Redis (Optional — caching disabled if unavailable) ---
REDIS_URL=redis://localhost:6379

# --- Qdrant (Optional — vector search disabled if unavailable) ---
QDRANT_URL=http://localhost:6333

# --- OpenSearch (Optional — fulltext search disabled if unavailable) ---
OPENSEARCH_URL=http://localhost:9200

# --- LLM via OpenRouter (Optional — /ask returns evidence-only without this) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI Embeddings (Optional — vector indexing disabled without this) ---
OPENAI_API_KEY=

# --- Admin Authentication (Required for upload/indexing endpoints) ---
ADMIN_API_KEY=

# --- Supabase Storage (Optional — uploads disabled without this) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=

# --- CORS (Comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Debug ---
DEBUG=false
